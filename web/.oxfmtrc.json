{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "singleQuote": false,
  "trailingComma": "none",
  "semi": true,
  "endOfLine": "lf",
  "bracketSameLine": true,
  "printWidth": 100,
  "quoteProps": "consistent",
  "svelte": true,
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./src/app.css"
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "/static/",
    "/build/",
    "/src/lib/api/schema.d.ts",
    "/src/lib/config/fixtures/view.json",
    "/test-results/"
  ]
}
