{
  "name": "reseek-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/relative-assets.js",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "format": "oxfmt .",
    "lint": "oxfmt --check . && oxlint",
    "test": "vitest run",
    "smoke": "playwright test",
    "api": "openapi-typescript ../api/openapi.json -o src/lib/api/schema.d.ts --empty-objects-unknown",
    "api-check": "openapi-typescript ../api/openapi.json -o src/lib/api/schema.d.ts --empty-objects-unknown --check"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.61.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tailwindcss": "^1.16.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "mode-watcher": "^1.1.0",
    "openapi-fetch": "^0.17.0"
  }
}
