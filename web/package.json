{
  "name": "reseek-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/relative-assets.js",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "format": "oxfmt .",
    "lint": "oxfmt --check . && oxlint",
    "test": "vitest run",
    "smoke": "playwright test",
    "api": "openapi-typescript ../api/openapi.json -o src/lib/api/schema.d.ts --empty-objects-unknown --default-non-nullable false",
    "api-check": "pnpm api --check"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lucide/svelte": "^1.65.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-table": "9.3.1",
    "@tanstack/virtual-core": "3.19.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "^26.6.6",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "layerchart": "2.9.2",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tailwindcss": "^1.17.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "d3-shape": "3.2.0",
    "flag-icons": "7.6.0",
    "mode-watcher": "^1.1.0",
    "openapi-fetch": "^0.17.0"
  }
}
